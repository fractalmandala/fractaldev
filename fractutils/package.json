{
	"name": "fractutils",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:styles": "node --test src/lib/styles/builder.test.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/styles/_composition-tests.sass"
	],
	"sideEffects": [
		"**/*.css",
		"**/*.sass"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles/vite": {
			"types": "./dist/styles/vite.d.ts",
			"import": "./dist/styles/vite.js"
		},
		"./styles/builder": {
			"types": "./dist/styles/builder.d.ts",
			"import": "./dist/styles/builder.js"
		},
		"./styles/config": {
			"sass": "./dist/styles/_01_config.sass"
		},
		"./styles/full.sass": {
			"sass": "./dist/styles/index.sass",
			"default": "./dist/styles/index.sass"
		}
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.63.0",
		"svelte": "^5.0.0",
		"vite": "^8.0.16"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"fractalicons": "^0.3.0",
		"globals": "^17.6.0",
		"mdsvex": "^0.12.7",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"fast-glob": "^3.3.3",
		"postcss": "^8.5.28",
		"postcss-selector-parser": "^7.1.6",
		"sass": "^1.104.0"
	}
}
