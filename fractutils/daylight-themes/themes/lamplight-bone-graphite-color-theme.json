  "semanticTokenColors": {
    "type": "#6FCBFF",
    "class": "#6FCBFF",
    "interface": "#6FCBFF",
    "enum": "#6FCBFF",
    "typeParameter": "#6FCBFF",
    "struct": "#6FCBFF",
    "namespace": "#6FCBFF",
    "function": "#FFD98A",
    "method": "#FFD98A",
    "decorator": "#FFD98A",
    "variable": "#DDE0E3",
    "parameter": "#DDE0E3",
    "property": "#DDE0E3",
    "enumMember": "#DCB4FF",
    "variable.readonly": "#DCB4FF",
    "keyword": "#FFB067",
    "operator": "#FFA47A",
    "string": "#B6E052",
    "number": "#DCB4FF",
    "comment": {
      "foreground": "#7A8085",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "strikethrough": true
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#7A8085",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#FFB067"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.accessor",
        "meta.arrow"
      ],
      "settings": {
        "foreground": "#FFA47A"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp",
        "punctuation.definition.string",
        "meta.embedded.assembly"
      ],
      "settings": {
        "foreground": "#B6E052"
      }
    },
    {
      "name": "String interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#FFA47A"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#DCB4FF"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#FFD98A"
      }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.parameter",
        "meta.type.annotation entity.name.type"
      ],
      "settings": {
        "foreground": "#6FCBFF"
      }
    },
    {
      "name": "Variable / parameter / property",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.object-literal.key",
        "support.variable",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#DDE0E3"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#7E848A"
      }
    },
    {
      "name": "Decorator / attribute",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFD98A"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.svelte"
      ],
      "settings": {
        "foreground": "#6FCBFF"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7E848A"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#DDE0E3"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#6FCBFF"
      }
    },
    {
      "name": "CSS unit",
      "scope": [
        "keyword.other.unit",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#DCB4FF"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#6FCBFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#FFB067"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#B6E052"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#7A8085",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7FD962"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F26D6D"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FFC44D"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F26D6D"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#7A8085",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#DDE0E3"
      }
    },
    {
      "name": "YAML key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#DDE0E3"
      }
    },
    {
      "name": "Shell / regex escape",
      "scope": [
        "constant.character.escape",
        "string.regexp keyword"
      ],
      "settings": {
        "foreground": "#FFA47A"
      }
    }
  ]
}
