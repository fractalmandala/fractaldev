  "semanticTokenColors": {
    "type": "#6CC0F5",
    "class": "#6CC0F5",
    "interface": "#6CC0F5",
    "enum": "#6CC0F5",
    "typeParameter": "#6CC0F5",
    "struct": "#6CC0F5",
    "namespace": "#6CC0F5",
    "function": "#E6BC68",
    "method": "#E6BC68",
    "decorator": "#E6BC68",
    "variable": "#C0C9D0",
    "parameter": "#C0C9D0",
    "property": "#C0C9D0",
    "enumMember": "#B2A6F5",
    "variable.readonly": "#B2A6F5",
    "keyword": "#F09A4C",
    "operator": "#F2A578",
    "string": "#66C9A9",
    "number": "#B2A6F5",
    "comment": {
      "foreground": "#6E7880",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "strikethrough": true
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#6E7880",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#F09A4C"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.accessor",
        "meta.arrow"
      ],
      "settings": {
        "foreground": "#F2A578"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp",
        "punctuation.definition.string",
        "meta.embedded.assembly"
      ],
      "settings": {
        "foreground": "#66C9A9"
      }
    },
    {
      "name": "String interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#F2A578"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#B2A6F5"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#E6BC68"
      }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.parameter",
        "meta.type.annotation entity.name.type"
      ],
      "settings": {
        "foreground": "#6CC0F5"
      }
    },
    {
      "name": "Variable / parameter / property",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.object-literal.key",
        "support.variable",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#C0C9D0"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#717B83"
      }
    },
    {
      "name": "Decorator / attribute",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E6BC68"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.svelte"
      ],
      "settings": {
        "foreground": "#6CC0F5"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#717B83"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#C0C9D0"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#6CC0F5"
      }
    },
    {
      "name": "CSS unit",
      "scope": [
        "keyword.other.unit",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#B2A6F5"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#6CC0F5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#F09A4C"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#66C9A9"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6E7880",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#5CC0A0"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#EC7A7A"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#E0B15A"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#EC7A7A"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#6E7880",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#C0C9D0"
      }
    },
    {
      "name": "YAML key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#C0C9D0"
      }
    },
    {
      "name": "Shell / regex escape",
      "scope": [
        "constant.character.escape",
        "string.regexp keyword"
      ],
      "settings": {
        "foreground": "#F2A578"
      }
    }
  ]
}
