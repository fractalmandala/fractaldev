  "semanticTokenColors": {
    "type": "#6FBBEE",
    "class": "#6FBBEE",
    "interface": "#6FBBEE",
    "enum": "#6FBBEE",
    "typeParameter": "#6FBBEE",
    "struct": "#6FBBEE",
    "namespace": "#6FBBEE",
    "function": "#E8C06A",
    "method": "#E8C06A",
    "decorator": "#E8C06A",
    "variable": "#C2C6C9",
    "parameter": "#C2C6C9",
    "property": "#C2C6C9",
    "enumMember": "#A9A6F0",
    "variable.readonly": "#A9A6F0",
    "keyword": "#FF9E4D",
    "operator": "#E8926A",
    "string": "#57C7A8",
    "number": "#A9A6F0",
    "comment": {
      "foreground": "#6E7478",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "strikethrough": true
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#6E7478",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#FF9E4D"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.accessor",
        "meta.arrow"
      ],
      "settings": {
        "foreground": "#E8926A"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp",
        "punctuation.definition.string",
        "meta.embedded.assembly"
      ],
      "settings": {
        "foreground": "#57C7A8"
      }
    },
    {
      "name": "String interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#E8926A"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#A9A6F0"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#E8C06A"
      }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.parameter",
        "meta.type.annotation entity.name.type"
      ],
      "settings": {
        "foreground": "#6FBBEE"
      }
    },
    {
      "name": "Variable / parameter / property",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.object-literal.key",
        "support.variable",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#C2C6C9"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#70767A"
      }
    },
    {
      "name": "Decorator / attribute",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E8C06A"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.svelte"
      ],
      "settings": {
        "foreground": "#6FBBEE"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#70767A"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#C2C6C9"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#6FBBEE"
      }
    },
    {
      "name": "CSS unit",
      "scope": [
        "keyword.other.unit",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#A9A6F0"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#6FBBEE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#FF9E4D"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#57C7A8"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6E7478",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#7FD962"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F26D6D"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FFC44D"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F26D6D"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#6E7478",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#C2C6C9"
      }
    },
    {
      "name": "YAML key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#C2C6C9"
      }
    },
    {
      "name": "Shell / regex escape",
      "scope": [
        "constant.character.escape",
        "string.regexp keyword"
      ],
      "settings": {
        "foreground": "#E8926A"
      }
    }
  ]
}
