  "semanticTokenColors": {
    "type": "#1A1C1F",
    "class": "#1A1C1F",
    "interface": "#1A1C1F",
    "enum": "#1A1C1F",
    "typeParameter": "#1A1C1F",
    "struct": "#1A1C1F",
    "namespace": "#1A1C1F",
    "function": "#1A1C1F",
    "method": "#1A1C1F",
    "decorator": "#1A1C1F",
    "variable": "#5A5E64",
    "parameter": "#5A5E64",
    "property": "#5A5E64",
    "enumMember": "#8A3070",
    "variable.readonly": "#8A3070",
    "keyword": "#7A7F85",
    "operator": "#9A9EA3",
    "string": "#8A3070",
    "number": "#8A3070",
    "comment": {
      "foreground": "#ADB1B5",
      "fontStyle": "italic"
    },
    "*.deprecated": {
      "strikethrough": true
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#ADB1B5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#7A7F85"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value",
        "punctuation.accessor",
        "meta.arrow"
      ],
      "settings": {
        "foreground": "#9A9EA3"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp",
        "punctuation.definition.string",
        "meta.embedded.assembly"
      ],
      "settings": {
        "foreground": "#8A3070"
      }
    },
    {
      "name": "String interpolation punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#9A9EA3"
      }
    },
    {
      "name": "Number / constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8A3070"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#1A1C1F"
      }
    },
    {
      "name": "Type / class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "entity.name.type.parameter",
        "meta.type.annotation entity.name.type"
      ],
      "settings": {
        "foreground": "#1A1C1F"
      }
    },
    {
      "name": "Variable / parameter / property",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.object-literal.key",
        "support.variable",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#5A5E64"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.definition.array",
        "punctuation.terminator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#B6BABE"
      }
    },
    {
      "name": "Decorator / attribute",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "storage.type.annotation",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#1A1C1F"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.svelte"
      ],
      "settings": {
        "foreground": "#1A1C1F"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#B6BABE"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#5A5E64"
      }
    },
    {
      "name": "CSS selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#1A1C1F"
      }
    },
    {
      "name": "CSS unit",
      "scope": [
        "keyword.other.unit",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#8A3070"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#1A1C1F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#8A3070"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#8A3070"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#ADB1B5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#3C7048"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#C0392B"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#A5720F"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C0392B"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#ADB1B5",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "JSON key",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#5A5E64"
      }
    },
    {
      "name": "YAML key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#5A5E64"
      }
    },
    {
      "name": "Shell / regex escape",
      "scope": [
        "constant.character.escape",
        "string.regexp keyword"
      ],
      "settings": {
        "foreground": "#9A9EA3"
      }
    }
  ]
}
