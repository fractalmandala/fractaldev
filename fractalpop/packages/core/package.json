{
  "name": "fractalpop",
  "version": "0.1.0",
  "description": "Lightweight, Svelte-first syntax highlighting with first-class indented Sass. Returns HTML without a DOM.",
  "type": "module",
  "sideEffects": [
    "./dist/full.js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fractalmandala/fractalpop.git",
    "directory": "packages/core"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./lang": {
      "types": "./dist/lang.d.ts",
      "default": "./dist/lang.js"
    },
    "./lang/*": {
      "types": "./dist/lang/*.d.ts",
      "default": "./dist/lang/*.js"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "default": "./dist/full.js"
    },
    "./gpu": {
      "types": "./dist/gpu.d.ts",
      "default": "./dist/gpu.js"
    }
  },
  "peerDependencies": {
    "gpu-lexer": ">=0.0.2"
  },
  "peerDependenciesMeta": {
    "gpu-lexer": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunchee",
    "dev": "bunchee --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "bunchee": "^6.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
