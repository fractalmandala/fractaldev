{
  "name": "@fractalpop/remark",
  "version": "0.1.0",
  "description": "remark plugin for fractalpop — highlights fenced code in .md and .mdx",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "remark-plugin",
    "mdx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunchee",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fractalpop": "workspace:^",
    "unist-util-map": "^4.0.0"
  },
  "devDependencies": {
    "bunchee": "^6.0.0",
    "remark": "^15.0.0",
    "remark-html": "^16.0.0",
    "vitest": "^4.1.11",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fractalmandala/fractalpop.git",
    "directory": "packages/remark"
  }
}
