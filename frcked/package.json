{
	"name": "frcked",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:editor": "node --experimental-strip-types scripts/verify-editor-deliveries.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"eslint": "^10.0.2",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.15.0",
		"fractalicons": "^0.3.0",
		"globals": "^17.3.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.5.0",
		"sass": "^1.104.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.0.0",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^8.0.12"
	},
	"dependencies": {
		"@types/dompurify": "^3.0.5",
		"dompurify": "^3.3.0",
		"knap": "^0.4.1",
		"latest": "^0.2.0",
		"marked": "^17.0.0",
		"fractalpop": "link:../fractalpop/packages/core",
		"@fractalpop/svelte": "link:../fractalpop/packages/svelte",
		"@fractalpop/mdsvex": "link:../fractalpop/packages/mdsvex"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"fsevents@2.3.3": true,
		"esbuild@0.28.2": true
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"esbuild"
		]
	}
}
