{
	"name": "acrolls",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.2",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"build": "pnpm -r --filter './packages/*' run build",
		"build:docs": "pnpm --filter @acrolls/docs build",
		"dev:ui": "vite dev",
		"dev:docs": "pnpm --parallel --stream --filter @acrolls/docs --filter @acrolls/example-kit run dev",
		"dev:example": "pnpm --filter @acrolls/example-kit dev",
		"build:example": "pnpm --filter @acrolls/example-kit build",
		"check": "pnpm -r --filter './packages/*' run check",
		"test": "pnpm -r --if-present --filter './packages/*' run test",
		"release:pack": "pnpm --config.node-linker=hoisted --filter acrolls pack",
		"verify:packed-consumer": "node ./scripts/verify-packed-consumer.mjs",
		"verify:fresh-consumer": "node ./scripts/verify-fresh-consumer.mjs",
		"release": "pnpm --config.node-linker=hoisted --filter acrolls publish --access public",
		"cli": "node ./packages/cli/dist/index.js",
		"acrolls": "node ./packages/acrolls/bin/acrolls.mjs"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.62.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.3",
		"acrolls": "workspace:*",
		"fractalstyler2": "^0.7.1",
		"mdsvex": "^0.12.6",
		"sass": "^1.102.0",
		"svelte": "^5.38.1",
		"typescript": "^5.9.2",
		"vite": "^7.1.3"
	},
	"dependencies": {
		"fractalthemer": "^0.1.0"
	}
}
