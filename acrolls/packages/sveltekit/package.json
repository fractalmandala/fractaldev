{
  "name": "@acrolls/sveltekit",
  "private": true,
  "version": "0.2.0",
  "description": "SvelteKit glue for Acrolls (source-safe mdsvex preprocessor + layout defaults).",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/fractalmandala/Acrolls.git", "directory": "packages/sveltekit" },
  "bugs": "https://github.com/fractalmandala/Acrolls/issues",
  "homepage": "https://github.com/fractalmandala/Acrolls#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "import": "./dist/content.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/content.ts --format esm --dts --clean",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@acrolls/docs": "workspace:*",
    "@acrolls/mdsvex": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@acrolls/svelte": "workspace:*",
    "mdsvex": ">=0.12.0"
  },
  "keywords": [
    "acrolls",
    "sveltekit",
    "mdsvex"
  ]
}
