{
  "name": "@acrolls/mdsvex",
  "private": true,
  "version": "0.1.1",
  "description": "Shared mdsvex compile and Markdown source-safety pipeline for Acrolls (slugs, tables, Shiki, Mermaid, fence meta).",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/fractalmandala/Acrolls.git", "directory": "packages/mdsvex" },
  "bugs": "https://github.com/fractalmandala/Acrolls/issues",
  "homepage": "https://github.com/fractalmandala/Acrolls#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sveltejs/acorn-typescript": "^1.0.12",
    "acorn": "^8.18.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.12.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "svelte": "^5.38.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "mdsvex": ">=0.12.0",
    "svelte": ">=5.0.0"
  },
  "keywords": [
    "acrolls",
    "mdsvex",
    "shiki",
    "sveltekit",
    "publishing"
  ]
}
