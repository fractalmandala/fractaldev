		"dev": "vite dev",
		"clean": "node scripts/clean.js",
		"generate": "node scripts/generate-icons.js",
		"build": "npm run generate && vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "npm run clean && svelte-kit sync && svelte-package && node scripts/clean.js --prune && publint",
